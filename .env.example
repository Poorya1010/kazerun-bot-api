DATABASE_URL=postgresql://kazerun:CHANGE_ME@localhost:5432/kazerun
PORT=3000

# Each platform is independent; empty tokens disable that platform.
BALE_BOT_TOKEN=
BALE_EDITORIAL_CHAT_ID=
BALE_EDITORIAL_ADMIN_IDS=
TELEGRAM_BOT_TOKEN=
TELEGRAM_EDITORIAL_CHAT_ID=
TELEGRAM_EDITORIAL_ADMIN_IDS=
RUBIKA_BOT_TOKEN=
RUBIKA_EDITORIAL_CHAT_ID=
RUBIKA_EDITORIAL_ADMIN_IDS=

# Comma-separated operator IDs above are REQUIRED for editorial actions.
# Keep this directory on a persistent disk. Run only ONE application instance.
BOT_STATE_DIR=./var/bot-state

# Set a random secret for development/internal HTTP APIs (x-api-key header).
# If empty, /reports, /users and /ai HTTP endpoints are disabled.
INTERNAL_API_KEY=

# Optional AI: failure does not prevent citizen submissions.
ARVAN_AI_BASE_URL=
ARVAN_AI_API_KEY=
ARVAN_AI_MODEL=GPT-5.6-Luna

# Rubika: empty URL = polling + chat keypads; HTTPS URL = inline keypads.
# Enter origin only, e.g. https://bot.example.com (no endpoint path).
# After configuring webhooks run: npm run bots:setup
RUBIKA_WEBHOOK_URL=
RUBIKA_WEBHOOK_SECRET=
